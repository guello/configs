{
  "name": "@guello/oxfmt-config",
  "version": "0.1.0",
  "description": "Shared Oxfmt presets: no semicolons, single quotes, and sorted imports.",
  "keywords": [
    "format",
    "formatter",
    "oxc",
    "oxfmt",
    "oxfmt-config"
  ],
  "homepage": "https://github.com/guello/configs/tree/main/packages/oxfmt-config#readme",
  "bugs": {
    "url": "https://github.com/guello/configs/issues"
  },
  "license": "MIT",
  "author": "Gabriele Canepa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guello/configs.git",
    "directory": "packages/oxfmt-config"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts.generator oxc --publint --fail-on-warn",
    "check:types": "tsc --noEmit",
    "prepack": "pnpm run build",
    "test": "pnpm run build && vitest run --dir test --exclude \"**/fixtures/**\""
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "oxfmt": ">=0.42.0 <1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
