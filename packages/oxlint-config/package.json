{
  "name": "@guello/oxlint-config",
  "version": "0.1.1",
  "description": "Shared Oxlint presets for TypeScript, with type-aware rules and the @guello/oxlint-plugin rules.",
  "keywords": [
    "lint",
    "oxc",
    "oxlint",
    "oxlint-config"
  ],
  "homepage": "https://github.com/guello/configs/tree/main/packages/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/guello/configs/issues"
  },
  "license": "MIT",
  "author": "Gabriele Canepa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guello/configs.git",
    "directory": "packages/oxlint-config"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts.generator oxc --publint --fail-on-warn",
    "check:types": "tsc --noEmit",
    "prepack": "pnpm run build",
    "test": "pnpm run build && vitest run --dir test --exclude \"**/fixtures/**\""
  },
  "dependencies": {
    "@guello/oxlint-plugin": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-plugin-react-doctor": "^0.9.22",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "oxlint": ">=1.88.0 <2",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "oxlint-tsgolint": ">=7.0.2005 <8"
  },
  "peerDependenciesMeta": {
    "oxlint-plugin-react-doctor": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
