{
  "name": "@guello/commitlint-config",
  "version": "0.0.0",
  "description": "Shared preset for Conventional Commits, with a defineConfig factory for types, scopes and overrides.",
  "keywords": [
    "commitlint",
    "commitlint-config",
    "conventional-commits"
  ],
  "homepage": "https://github.com/guello/configs/tree/main/packages/commitlint-config#readme",
  "bugs": {
    "url": "https://github.com/guello/configs/issues"
  },
  "license": "MIT",
  "author": "Gabriele Canepa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guello/configs.git",
    "directory": "packages/commitlint-config"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/preset.ts --dts.generator oxc --publint --fail-on-warn",
    "check:types": "tsc --noEmit",
    "prepack": "pnpm run build",
    "test": "pnpm run build && vitest run --dir test --exclude \"**/fixtures/**\""
  },
  "dependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@commitlint/cli": ">=21.2.4 <22"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
